        ixy="0.00000"
        ixz="0.00000"
        iyy="0.00017"
        iyz="0.00000"
        izz="0.00016" />
    </inertial>
    <!-- 
    URDF 中 <visual> 和 <collision> 是分离的，而在 MJCF 中，<geom> 可以通过contype和conaffinity属性结合group值区分可视化和碰撞.
    By default, groups 0, 1 and 2 are visible, while all other groups are invisible.
    group默认为0
    默认值：默认情况下，contype 和 conaffinity 都是 1，这意味着所有几何体默认会相互碰撞
    碰撞排除：如果一个几何体的 contype 和 conaffinity 都是 0，则该几何体不会与其他任何几何体发生碰撞
     -->
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://X5A/meshes/base_link.STL" />
