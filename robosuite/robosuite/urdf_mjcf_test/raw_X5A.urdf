  <joint
    name="joint1"
    type="revolute">
    <origin
      xyz="0 0 0.0605"
      rpy="0 0 0" />
    <parent
      link="base_link" />
    <child
      link="link1" />
      <!-- axis定义关节的旋转轴，xyz 表示旋转轴方向 -->
    <axis
      xyz="0 0 1" />
          <!-- 
          lower 为最小限位，upper 为最大限位，effort 为最大允许力或力矩，velocity 为最大速度
          lower和upper合并为MJCF的ctrlrange属性
          effort转换为MJCF的forcerange
          URDF的velocity限制在MJCF中不是必需的，通常可以省略
           -->
    <limit
      lower="-10"
      upper="10"
      effort="100"
      velocity="1000" />
  </joint>
